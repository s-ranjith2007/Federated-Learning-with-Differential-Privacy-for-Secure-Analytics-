<span class="kw">import</span> torch
<span class="kw">import</span> torch.nn <span class="kw">as</span> nn
<span class="kw">import</span> torch.optim <span class="kw">as</span> optim
<span class="kw">from</span> torch.utils.data <span class="kw">import</span> DataLoader, random_split, TensorDataset
<span class="kw">from</span> opacus <span class="kw">import</span> PrivacyEngine
<span class="kw">from</span> opacus.accountants <span class="kw">import</span> RDPAccountant
<span class="kw">import</span> numpy <span class="kw">as</span> np
<span class="kw">from</span> copy <span class="kw">import</span> deepcopy
<span class="kw">from</span> tqdm <span class="kw">import</span> tqdm
<span class="kw">from</span> dataclasses <span class="kw">import</span> dataclass
<span class="kw">from</span> typing <span class="kw">import</span> List, Dict, Tuple
<span class="kw">import</span> logging

logging.basicConfig(level=logging.INFO, format=<span class="st">"%(asctime)s [%(levelname)s] %(message)s"</span>)
logger = logging.getLogger(<span class="st">"fedpriv"</span>)


<span class="cm"># ─────────────────────────── Config ───────────────────────────</span>

@dataclass
<span class="kw">class</span> <span class="tp">FedDPConfig</span>:
    <span class="cm">"""Hyperparameters for the federated + DP training run."""</span>
    <span class="cm"># Federated</span>
    num_clients: <span class="tp">int</span> = <span class="nu">10</span>
    clients_per_round: <span class="tp">int</span> = <span class="nu">5</span>      <span class="cm"># C  — fraction selected each round</span>
    num_rounds: <span class="tp">int</span> = <span class="nu">50</span>
    local_epochs: <span class="tp">int</span> = <span class="nu">2</span>
    local_batch_size: <span class="tp">int</span> = <span class="nu">64</span>
    local_lr: <span class="tp">float</span> = <span class="nu">0.01</span>

    <span class="cm"># Differential Privacy</span>
    target_epsilon: <span class="tp">float</span> = <span class="nu">1.0</span>     <span class="cm"># privacy budget  ε</span>
    target_delta: <span class="tp">float</span> = <span class="nu">1e-5</span>      <span class="cm"># failure prob    δ</span>
    max_grad_norm: <span class="tp">float</span> = <span class="nu">1.0</span>     <span class="cm"># clipping bound  C</span>
    noise_multiplier: <span class="tp">float</span> = <span class="nu">1.2</span>   <span class="cm"># σ (tune for ε/δ)</span>

    <span class="cm"># Model</span>
    input_dim: <span class="tp">int</span> = <span class="nu">784</span>
    hidden_dim: <span class="tp">int</span> = <span class="nu">128</span>
    output_dim: <span class="tp">int</span> = <span class="nu">10</span>
    device: <span class="tp">str</span> = <span class="st">"cuda"</span> <span class="kw">if</span> torch.cuda.is_available() <span class="kw">else</span> <span class="st">"cpu"</span>


<span class="cm"># ─────────────────────────── Model ────────────────────────────</span>

<span class="kw">class</span> <span class="tp">SimpleNet</span>(nn.Module):
    <span class="kw">def</span> <span class="fn">__init__</span>(self, cfg: <span class="tp">FedDPConfig</span>):
        <span class="fn">super</span>().__init__()
        self.net = nn.Sequential(
            nn.Linear(cfg.input_dim, cfg.hidden_dim),
            nn.ReLU(),
            nn.Dropout(<span class="nu">0.2</span>),
            nn.Linear(cfg.hidden_dim, cfg.hidden_dim),
            nn.ReLU(),
            nn.Linear(cfg.hidden_dim, cfg.output_dim),
        )

    <span class="kw">def</span> <span class="fn">forward</span>(self, x: torch.Tensor) -> torch.Tensor:
        <span class="kw">return</span> self.net(x.view(x.size(<span class="nu">0</span>), -<span class="nu">1</span>))


<span class="cm"># ─────────────────────── Federated Server ─────────────────────</span>

<span class="kw">class</span> <span class="tp">FederatedServer</span>:
    <span class="kw">def</span> <span class="fn">__init__</span>(self, model: nn.Module, cfg: <span class="tp">FedDPConfig</span>):
        self.global_model = model.to(cfg.device)
        self.cfg = cfg
        self.privacy_budget_spent = <span class="nu">0.0</span>
        self.round_history: List[Dict] = []

    <span class="kw">def</span> <span class="fn">select_clients</span>(self, clients: List[<span class="st">"FederatedClient"</span>]):
        k = self.cfg.clients_per_round
        <span class="kw">return</span> np.random.choice(clients, k, replace=<span class="kw">False</span>)

    <span class="kw">def</span> <span class="fn">aggregate</span>(self, client_updates: List[Dict[<span class="tp">str</span>, torch.Tensor]], weights: List[<span class="tp">float</span>]):
        <span class="cm">"""FedAvg: weighted average of client model deltas."""</span>
        total_w = <span class="fn">sum</span>(weights)
        global_sd = self.global_model.state_dict()
        agg = {k: torch.zeros_like(v) <span class="kw">for</span> k, v <span class="kw">in</span> global_sd.items()}

        <span class="kw">for</span> update, w <span class="kw">in</span> zip(client_updates, weights):
            <span class="kw">for</span> key <span class="kw">in</span> agg:
                agg[key] += (w / total_w) * update[key].to(self.cfg.device)

        self.global_model.load_state_dict(agg)

    <span class="kw">def</span> <span class="fn">track_privacy</span>(self, epsilon: <span class="tp">float</span>):
        self.privacy_budget_spent = epsilon
        <span class="kw">if</span> epsilon > self.cfg.target_epsilon:
            logger.warning(<span class="st">f"⚠️  Privacy budget exceeded: ε={epsilon:.3f} > {self.cfg.target_epsilon}"</span>)


<span class="cm"># ─────────────────────── Federated Client ─────────────────────</span>

<span class="kw">class</span> <span class="tp">FederatedClient</span>:
    <span class="kw">def</span> <span class="fn">__init__</span>(self, client_id: <span class="tp">int</span>, dataset: TensorDataset, cfg: <span class="tp">FedDPConfig</span>):
        self.client_id = client_id
        self.dataset = dataset
        self.cfg = cfg
        self.n_samples = len(dataset)

    <span class="kw">def</span> <span class="fn">local_train</span>(self, global_weights: Dict) -> Tuple[Dict, <span class="tp">float</span>]:
        <span class="cm">"""Train locally with DP-SGD, return noisy delta and epsilon spent."""</span>
        model = SimpleNet(self.cfg).to(self.cfg.device)
        model.load_state_dict(deepcopy(global_weights))

        loader = DataLoader(self.dataset, batch_size=self.cfg.local_batch_size, shuffle=<span class="kw">True</span>)
        optimizer = optim.SGD(model.parameters(), lr=self.cfg.local_lr, momentum=<span class="nu">0.9</span>)
        criterion = nn.CrossEntropyLoss()

        <span class="cm"># Attach Opacus PrivacyEngine for DP-SGD</span>
        privacy_engine = PrivacyEngine()
        model, optimizer, loader = privacy_engine.make_private_with_epsilon(
            module=model,
            optimizer=optimizer,
            data_loader=loader,
            epochs=self.cfg.local_epochs,
            target_epsilon=self.cfg.target_epsilon,
            target_delta=self.cfg.target_delta,
            max_grad_norm=self.cfg.max_grad_norm,
        )

        model.train()
        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(self.cfg.local_epochs):
            <span class="kw">for</span> x, y <span class="kw">in</span> loader:
                x, y = x.to(self.cfg.device), y.to(self.cfg.device)
                optimizer.zero_grad()
                loss = criterion(model(x), y)
                loss.backward()
                optimizer.step()

        epsilon = privacy_engine.get_epsilon(self.cfg.target_delta)
        <span class="kw">return</span> model._module.state_dict(), epsilon


<span class="cm"># ─────────────────────── Training Loop ────────────────────────</span>

<span class="kw">def</span> <span class="fn">evaluate</span>(model: nn.Module, loader: DataLoader, device: <span class="tp">str</span>) -> <span class="tp">float</span>:
    model.eval()
    correct = total = <span class="nu">0</span>
    <span class="kw">with</span> torch.no_grad():
        <span class="kw">for</span> x, y <span class="kw">in</span> loader:
            x, y = x.to(device), y.to(device)
            preds = model(x).argmax(dim=<span class="nu">1</span>)
            correct += (preds == y).<span class="fn">sum</span>().item()
            total += y.size(<span class="nu">0</span>)
    <span class="kw">return</span> correct / total


<span class="kw">def</span> <span class="fn">federated_train</span>(cfg: <span class="tp">FedDPConfig</span> = <span class="kw">None</span>):
    cfg = cfg <span class="kw">or</span> FedDPConfig()
    logger.info(<span class="st">f"Starting FedDP training | ε={cfg.target_epsilon} δ={cfg.target_delta} clients={cfg.num_clients}"</span>)

    <span class="cm"># Synthetic dataset — replace with real loaders</span>
    X = torch.randn(<span class="nu">10000</span>, cfg.input_dim)
    y = torch.randint(<span class="nu">0</span>, cfg.output_dim, (<span class="nu">10000</span>,))
    full_ds = TensorDataset(X, y)

    <span class="cm"># Split data across clients (non-IID via Dirichlet split in prod)</span>
    sizes = [<span class="fn">len</span>(full_ds) // cfg.num_clients] * cfg.num_clients
    sizes[-<span class="nu">1</span>] += <span class="fn">len</span>(full_ds) - <span class="fn">sum</span>(sizes)
    client_datasets = random_split(full_ds, sizes)

    <span class="cm"># Init</span>
    global_model = SimpleNet(cfg).to(cfg.device)
    server = FederatedServer(global_model, cfg)
    clients = [FederatedClient(i, ds, cfg) <span class="kw">for</span> i, ds <span class="kw">in</span> <span class="fn">enumerate</span>(client_datasets)]

    test_X = torch.randn(<span class="nu">2000</span>, cfg.input_dim)
    test_y = torch.randint(<span class="nu">0</span>, cfg.output_dim, (<span class="nu">2000</span>,))
    test_loader = DataLoader(TensorDataset(test_X, test_y), batch_size=<span class="nu">256</span>)

    <span class="kw">for</span> rnd <span class="kw">in</span> tqdm(<span class="fn">range</span>(<span class="nu">1</span>, cfg.num_rounds + <span class="nu">1</span>), desc=<span class="st">"Federated Rounds"</span>):
        selected = server.select_clients(clients)
        updates, epsilons, sample_counts = [], [], []

        <span class="kw">for</span> client <span class="kw">in</span> selected:
            weights, eps = client.local_train(server.global_model.state_dict())
            updates.append(weights)
            epsilons.append(eps)
            sample_counts.append(client.n_samples)

        server.aggregate(updates, sample_counts)
        max_eps = <span class="fn">max</span>(epsilons)
        server.track_privacy(max_eps)

        <span class="kw">if</span> rnd % <span class="nu">5</span> == <span class="nu">0</span>:
            acc = evaluate(server.global_model, test_loader, cfg.device)
            logger.info(<span class="st">f"Round {rnd:3d} | Accuracy: {acc:.4f} | ε_spent: {max_eps:.4f}"</span>)

        <span class="kw">if</span> server.privacy_budget_spent > cfg.target_epsilon:
            logger.warning(<span class="st">"Privacy budget exhausted — stopping early."</span>)
            <span class="kw">break</span>

    logger.info(<span class="st">"✅ Training complete"</span>)
    <span class="kw">return</span> server.global_model


<span class="kw">if</span> __name__ == <span class="st">"__main__"</span>:
    cfg = FedDPConfig(num_clients=<span class="nu">10</span>, num_rounds=<span class="nu">30</span>, target_epsilon=<span class="nu">1.0</span>)
    model = federated_train(cfg)</pre>
