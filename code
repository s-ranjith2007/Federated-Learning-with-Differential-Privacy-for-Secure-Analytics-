<span class="kw">import</span> numpy <span class="kw">as</span> np
<span class="kw">from</span> scipy <span class="kw">import</span> optimize
<span class="kw">from</span> typing <span class="kw">import</span> Optional, Tuple
<span class="kw">import</span> warnings


<span class="kw">class</span> <span class="tp">GaussianPrivacyAccountant</span>:
    <span class="cm">"""
    RDP (Rényi Differential Privacy) accountant for the Gaussian mechanism.
    Converts (α, ε_α)-RDP → (ε, δ)-DP via Proposition 3 of Mironov (2017).
    """</span>

    <span class="kw">def</span> <span class="fn">__init__</span>(self, noise_multiplier: <span class="tp">float</span>, sampling_rate: <span class="tp">float</span>):
        self.sigma = noise_multiplier
        self.q = sampling_rate          <span class="cm"># batch_size / dataset_size</span>
        self.steps = <span class="nu">0</span>
        self._alphas = np.arange(<span class="nu">2</span>, <span class="nu">256</span>)  <span class="cm"># Rényi orders</span>

    <span class="kw">def</span> <span class="fn">step</span>(self, n_steps: <span class="tp">int</span> = <span class="nu">1</span>):
        <span class="cm">"""Call after each gradient step."""</span>
        self.steps += n_steps

    <span class="kw">def</span> <span class="fn">_rdp_gaussian</span>(self, alpha: <span class="tp">float</span>) -> <span class="tp">float</span>:
        <span class="cm">"""Compute RDP ε_α for one step of the Gaussian mechanism (Mironov, 2017)."""</span>
        <span class="kw">return</span> alpha / (<span class="nu">2</span> * self.sigma ** <span class="nu">2</span>)

    <span class="kw">def</span> <span class="fn">_rdp_subsampled</span>(self, alpha: <span class="tp">float</span>) -> <span class="tp">float</span>:
        <span class="cm">"""Poisson subsampling amplification (Wang et al., 2019)."""</span>
        q = self.q
        <span class="kw">if</span> q == <span class="nu">1.0</span>:
            <span class="kw">return</span> self._rdp_gaussian(alpha)
        rdp_full = self._rdp_gaussian(alpha)
        <span class="cm"># First-order approximation: ε_subsampled ≈ log(1 + q²(e^{ε_full} - 1)) / (α-1)</span>
        log_moment = np.log1p(q * q * (np.exp(rdp_full * (alpha - <span class="nu">1</span>)) - <span class="nu">1</span>))
        <span class="kw">return</span> log_moment / (alpha - <span class="nu">1</span>)

    <span class="kw">def</span> <span class="fn">get_epsilon</span>(self, delta: <span class="tp">float</span>) -> <span class="tp">float</span>:
        <span class="cm">"""Convert accumulated RDP to (ε, δ)-DP."""</span>
        <span class="kw">if</span> self.steps == <span class="nu">0</span>:
            <span class="kw">return</span> <span class="nu">0.0</span>
        epsilons = []
        <span class="kw">for</span> alpha <span class="kw">in</span> self._alphas:
            rdp = self.steps * self._rdp_subsampled(float(alpha))
            <span class="cm"># Proposition 3: ε = rdp - log(δ) / (α-1)</span>
            eps = rdp + np.log(<span class="nu">1</span> - <span class="nu">1</span>/alpha) - np.log(delta * alpha) / (alpha - <span class="nu">1</span>)
            epsilons.append(eps)
        <span class="kw">return</span> <span class="fn">min</span>(epsilons)

    <span class="kw">def</span> <span class="fn">calibrate_noise</span>(self, target_epsilon: <span class="tp">float</span>, target_delta: <span class="tp">float</span>, n_steps: <span class="tp">int</span>) -> <span class="tp">float</span>:
        <span class="cm">"""Find the minimum σ to achieve (target_ε, target_δ)-DP over n_steps."""</span>
        <span class="kw">def</span> <span class="fn">objective</span>(sigma_val):
            acct = GaussianPrivacyAccountant(sigma_val, self.q)
            acct.step(n_steps)
            <span class="kw">return</span> acct.get_epsilon(target_delta) - target_epsilon

        lo, hi = <span class="nu">0.01</span>, <span class="nu">100.0</span>
        <span class="kw">try</span>:
            result = optimize.brentq(objective, lo, hi, xtol=<span class="nu">1e-4</span>)
        <span class="kw">except</span> <span class="tp">ValueError</span>:
            warnings.warn(<span class="st">"Could not calibrate noise — returning σ=∞"</span>)
            result = <span class="tp">float</span>(<span class="st">"inf"</span>)
        <span class="kw">return</span> result


<span class="kw">class</span> <span class="tp">PrivacyBudgetTracker</span>:
    <span class="cm">"""Track epsilon across rounds for early stopping and reporting."""</span>

    <span class="kw">def</span> <span class="fn">__init__</span>(self, max_epsilon: <span class="tp">float</span>, delta: <span class="tp">float</span>):
        self.max_epsilon = max_epsilon
        self.delta = delta
        self._rounds: list = []

    <span class="kw">def</span> <span class="fn">record</span>(self, round_num: <span class="tp">int</span>, epsilon: <span class="tp">float</span>):
        self._rounds.append({<span class="st">"round"</span>: round_num, <span class="st">"epsilon"</span>: epsilon})

    @property
    <span class="kw">def</span> <span class="fn">current_epsilon</span>(self) -> <span class="tp">float</span>:
        <span class="kw">return</span> self._rounds[-<span class="nu">1</span>][<span class="st">"epsilon"</span>] <span class="kw">if</span> self._rounds <span class="kw">else</span> <span class="nu">0.0</span>

    @property
    <span class="kw">def</span> <span class="fn">budget_remaining</span>(self) -> <span class="tp">float</span>:
        <span class="kw">return</span> <span class="fn">max</span>(<span class="nu">0.0</span>, self.max_epsilon - self.current_epsilon)

    @property
    <span class="kw">def</span> <span class="fn">budget_exhausted</span>(self) -> <span class="tp">bool</span>:
        <span class="kw">return</span> self.current_epsilon >= self.max_epsilon

    <span class="kw">def</span> <span class="fn">report</span>(self):
        <span class="kw">if not</span> self._rounds:
            <span class="kw">return</span>
        last = self._rounds[-<span class="nu">1</span>]
        pct = <span class="nu">100</span> * last[<span class="st">"epsilon"</span>] / self.max_epsilon
        print(<span class="st">f"Privacy Report (Round {last['round']})"</span>)
        print(<span class="st">f"  ε spent:     {last['epsilon']:.4f} / {self.max_epsilon} ({pct:.1f}%)"</span>)
        print(<span class="st">f"  δ:           {self.delta}"</span>)
        print(<span class="st">f"  Remaining:   {self.budget_remaining:.4f}"</span>)
        print(<span class="st">f"  Exhausted:   {self.budget_exhausted}"</span>)


<span class="cm"># ─── Noise calibration utility ──────────────────────────────</span>

<span class="kw">def</span> <span class="fn">compute_sigma_for_epsilon</span>(
    target_epsilon: <span class="tp">float</span>,
    target_delta: <span class="tp">float</span>,
    sampling_rate: <span class="tp">float</span>,
    n_steps: <span class="tp">int</span>,
) -> <span class="tp">float</span>:
    <span class="cm">"""Return noise multiplier σ for given (ε, δ, q, T)."""</span>
    acct = GaussianPrivacyAccountant(<span class="nu">1.0</span>, sampling_rate)
    <span class="kw">return</span> acct.calibrate_noise(target_epsilon, target_delta, n_steps)


<span class="cm"># ─── Quick sanity check ──────────────────────────────────────</span>

