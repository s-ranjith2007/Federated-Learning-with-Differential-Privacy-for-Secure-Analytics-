<span class="kw">class</span> <span class="tp">SecureAggregationServer</span>:
    <span class="cm">"""
    Federated server supporting:
      • FedAvg (McMahan et al.)
      • FedProx (Li et al.)
      • Momentum-based aggregation
      • Byzantine-robust aggregation (Krum, Median)
    """</span>

    <span class="kw">def</span> <span class="fn">__init__</span>(self, global_model: nn.Module, cfg, aggregation: <span class="tp">str</span> = <span class="st">"fedavg"</span>):
        self.global_model = global_model
        self.cfg = cfg
        self.aggregation = aggregation
        self.round = <span class="nu">0</span>
        self.history: List[Dict] = []
        self._server_momentum: Optional[Dict] = <span class="kw">None</span>
        self.beta = <span class="nu">0.9</span>   <span class="cm"># momentum coefficient</span>

    <span class="cm"># ─── Aggregation Methods ───────────────────────────────────</span>

    <span class="kw">def</span> <span class="fn">fedavg</span>(self, updates: List[Dict], weights: List[<span class="tp">float</span>]) -> Dict:
        total = <span class="fn">sum</span>(weights)
        agg = {k: torch.zeros_like(v) <span class="kw">for</span> k, v <span class="kw">in</span> updates[<span class="nu">0</span>].items()}
        <span class="kw">for</span> upd, w <span class="kw">in</span> zip(updates, weights):
            <span class="kw">for</span> k <span class="kw">in</span> agg:
                agg[k] += (w / total) * upd[k].to(self.cfg.device)
        <span class="kw">return</span> agg

    <span class="kw">def</span> <span class="fn">fedprox</span>(self, updates: List[Dict], weights: List[<span class="tp">float</span>], mu: <span class="tp">float</span> = <span class="nu">0.01</span>) -> Dict:
        <span class="cm">"""FedProx: add proximal term to FedAvg to handle heterogeneity."""</span>
        agg = self.fedavg(updates, weights)
        global_sd = self.global_model.state_dict()
        <span class="kw">for</span> k <span class="kw">in</span> agg:
            <span class="kw">if</span> agg[k].dtype.is_floating_point:
                agg[k] = agg[k] - mu * (agg[k] - global_sd[k].to(self.cfg.device))
        <span class="kw">return</span> agg

    <span class="kw">def</span> <span class="fn">coordinate_median</span>(self, updates: List[Dict]) -> Dict:
        <span class="cm">"""Byzantine-robust: coordinate-wise median (Xie et al., 2018)."""</span>
        agg = {}
        <span class="kw">for</span> k <span class="kw">in</span> updates[<span class="nu">0</span>]:
            stacked = torch.stack([u[k].to(self.cfg.device) <span class="kw">for</span> u <span class="kw">in</span> updates])
            agg[k] = stacked.median(dim=<span class="nu">0</span>).values
        <span class="kw">return</span> agg

    <span class="kw">def</span> <span class="fn">krum</span>(self, updates: List[Dict], f: <span class="tp">int</span> = <span class="nu">1</span>) -> Dict:
        <span class="cm">"""Krum: select update least influenced by f Byzantine clients."""</span>
        n = <span class="fn">len</span>(updates)
        flat = [torch.cat([v.flatten() <span class="kw">for</span> v <span class="kw">in</span> u.values()]) <span class="kw">for</span> u <span class="kw">in</span> updates]
        scores = []
        <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(n):
            dists = sorted([torch.norm(flat[i] - flat[j]).item() ** <span class="nu">2</span> <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(n) <span class="kw">if</span> j != i])
            scores.append(<span class="fn">sum</span>(dists[:n - f - <span class="nu">2</span>]))
        best_idx = np.argmin(scores)
        logger.info(<span class="st">f"Krum selected client index {best_idx} (score={scores[best_idx]:.4f})"</span>)
        <span class="kw">return</span> updates[best_idx]

    <span class="kw">def</span> <span class="fn">aggregate_with_momentum</span>(self, new_agg: Dict) -> Dict:
        <span class="cm">"""Server-side Nesterov momentum across rounds."""</span>
        <span class="kw">if</span> self._server_momentum <span class="kw">is None</span>:
            self._server_momentum = {k: torch.zeros_like(v) <span class="kw">for</span> k, v <span class="kw">in</span> new_agg.items()}
        <span class="kw">for</span> k <span class="kw">in</span> new_agg:
            self._server_momentum[k] = self.beta * self._server_momentum[k] + new_agg[k]
            new_agg[k] = new_agg[k] + self.beta * self._server_momentum[k]
        <span class="kw">return</span> new_agg

    <span class="cm"># ─── Main Step ─────────────────────────────────────────────</span>

    <span class="kw">def</span> <span class="fn">step</span>(self, updates: List[Dict], weights: List[<span class="tp">float</span>], epsilons: List[<span class="tp">float</span>]):
        <span class="kw">if</span> self.aggregation == <span class="st">"fedavg"</span>:
            agg = self.fedavg(updates, weights)
        <span class="kw">elif</span> self.aggregation == <span class="st">"fedprox"</span>:
            agg = self.fedprox(updates, weights)
        <span class="kw">elif</span> self.aggregation == <span class="st">"median"</span>:
            agg = self.coordinate_median(updates)
        <span class="kw">elif</span> self.aggregation == <span class="st">"krum"</span>:
            agg = self.krum(updates)
        <span class="kw">else</span>:
            <span class="kw">raise</span> <span class="tp">ValueError</span>(<span class="st">f"Unknown aggregation: {self.aggregation}"</span>)

        self.global_model.load_state_dict(agg)
        self.round += <span class="nu">1</span>
        self.history.append({
            <span class="st">"round"</span>: self.round,
            <span class="st">"epsilon_max"</span>: <span class="fn">max</span>(epsilons),
            <span class="st">"epsilon_mean"</span>: np.mean(epsilons),
            <span class="st">"n_clients"</span>: <span class="fn">len</span>(updates),
        })
        logger.info(
            <span class="st">f"Round {self.round} | n={len(updates)} | "
            f"ε_max={max(epsilons):.4f} ε_mean={np.mean(epsilons):.4f}"</span>
        )
        <span class="kw">return</span> <span class="fn">max</span>(epsilons)

    <span class="kw">def</span> <span class="fn">get_global_weights</span>(self) -> Dict:
        <span class="kw">return</span> deepcopy(self.global_model.state_dict())</pre>
