<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FedPriv — Federated Learning with Differential Privacy</title>
<style>
  :root {
    --bg: #0a0c10;
    --surface: #111318;
    --card: #161920;
    --border: rgba(255,255,255,0.07);
    --border-bright: rgba(255,255,255,0.14);
    --text: #e8eaf0;
    --muted: #7a7f8e;
    --accent: #4f8ef7;
    --accent2: #38d9a9;
    --accent3: #f79c4f;
    --danger: #f75555;
    --font: 'Inter', -apple-system, sans-serif;
    --mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    --radius: 10px;
    --radius-lg: 16px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { background: var(--bg); color: var(--text); font-family: var(--font); font-size: 15px; line-height: 1.7; overflow-x: hidden; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* NAV */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(10,12,16,0.85); backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; height: 56px;
  }
  .nav-logo { font-weight: 700; font-size: 17px; letter-spacing: -0.5px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .nav-logo .dot { width: 8px; height: 8px; background: var(--accent2); border-radius: 50%; display: inline-block; }
  .nav-links { display: flex; gap: 28px; list-style: none; }
  .nav-links a { color: var(--muted); font-size: 14px; transition: color .2s; }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .nav-badge { background: var(--accent); color: #fff; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 20px; margin-left: 8px; }

  /* SECTIONS */
  section { padding: 80px 40px; max-width: 1100px; margin: 0 auto; }
  .section-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; color: var(--accent2); text-transform: uppercase; margin-bottom: 12px; }
  h1 { font-size: clamp(32px, 5vw, 56px); font-weight: 800; letter-spacing: -1.5px; line-height: 1.1; }
  h2 { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px; }
  h3 { font-size: 18px; font-weight: 600; margin-bottom: 8px; }

  /* HERO */
  .hero { padding-top: 100px; padding-bottom: 80px; text-align: center; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(79,142,247,0.1); border: 1px solid rgba(79,142,247,0.25); border-radius: 20px; padding: 5px 14px; font-size: 13px; color: var(--accent); margin-bottom: 28px; }
  .hero h1 span { color: var(--accent2); }
  .hero-sub { font-size: 18px; color: var(--muted); max-width: 640px; margin: 20px auto 40px; line-height: 1.6; }
  .btn-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 24px; border-radius: var(--radius); font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: transform .15s, opacity .15s; }
  .btn:hover { opacity: 0.88; transform: translateY(-1px); text-decoration: none; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-ghost { background: transparent; border: 1px solid var(--border-bright); color: var(--text); }
  .hero-stats { display: flex; gap: 48px; justify-content: center; margin-top: 64px; padding-top: 48px; border-top: 1px solid var(--border); }
  .hero-stat-val { font-size: 28px; font-weight: 800; color: var(--text); letter-spacing: -1px; }
  .hero-stat-lbl { font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* ARCHITECTURE DIAGRAM */
  .arch-diagram { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 40px 32px; margin-top: 40px; overflow: auto; }

  /* GRID CARDS */
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 36px; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 28px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; transition: border-color .2s; }
  .card:hover { border-color: var(--border-bright); }
  .card-icon { font-size: 22px; margin-bottom: 14px; }
  .card p { color: var(--muted); font-size: 14px; line-height: 1.65; margin-top: 6px; }

  /* CODE BLOCKS */
  .code-tabs { display: flex; gap: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding: 10px 16px 0; margin-top: 36px; border-bottom: none; }
  .code-tab { font-size: 13px; color: var(--muted); cursor: pointer; padding: 8px 14px; border-radius: 8px 8px 0 0; border: 1px solid transparent; border-bottom: none; transition: color .2s, background .2s; }
  .code-tab.active { color: var(--text); background: var(--card); border-color: var(--border); }
  .code-block { background: var(--card); border: 1px solid var(--border); border-radius: 0 0 var(--radius-lg) var(--radius-lg); overflow: auto; position: relative; }
  .code-block pre { padding: 24px 28px; font-family: var(--mono); font-size: 13px; line-height: 1.65; color: #abb2bf; white-space: pre; overflow-x: auto; }
  .copy-btn { position: absolute; top: 12px; right: 14px; background: rgba(255,255,255,0.07); border: 1px solid var(--border-bright); color: var(--muted); font-size: 12px; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-family: var(--font); transition: background .2s; }
  .copy-btn:hover { background: rgba(255,255,255,0.13); color: var(--text); }
  .copy-btn.copied { color: var(--accent2); border-color: var(--accent2); }

  /* Syntax colors */
  .kw { color: #c678dd; }
  .fn { color: #61afef; }
  .st { color: #98c379; }
  .cm { color: #5c6370; font-style: italic; }
  .nu { color: #d19a66; }
  .tp { color: #e5c07b; }
  .op { color: #56b6c2; }

  /* PRIVACY METER */
  .privacy-meter { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; margin-top: 36px; }
  .meter-row { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
  .meter-label { font-size: 13px; color: var(--muted); min-width: 120px; }
  .meter-bar { flex: 1; height: 8px; background: rgba(255,255,255,0.08); border-radius: 4px; overflow: hidden; }
  .meter-fill { height: 100%; border-radius: 4px; transition: width 1s ease; }
  .meter-val { font-size: 13px; font-weight: 600; min-width: 48px; text-align: right; }

  /* FLOW STEPS */
  .flow-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0; margin-top: 36px; }
  .flow-step { background: var(--card); border: 1px solid var(--border); padding: 20px 18px; position: relative; }
  .flow-step:first-child { border-radius: var(--radius-lg) 0 0 var(--radius-lg); }
  .flow-step:last-child { border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .flow-step + .flow-step { border-left: none; }
  .step-num { font-size: 11px; font-weight: 700; color: var(--accent); letter-spacing: 1px; margin-bottom: 8px; }
  .flow-step h4 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
  .flow-step p { font-size: 12px; color: var(--muted); line-height: 1.5; }
  .flow-arrow { position: absolute; right: -12px; top: 50%; transform: translateY(-50%); color: var(--muted); z-index: 2; font-size: 18px; }

  /* EPSILON TABLE */
  table { width: 100%; border-collapse: collapse; margin-top: 28px; font-size: 14px; }
  th { background: var(--card); border: 1px solid var(--border); padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: var(--muted); text-transform: uppercase; }
  td { border: 1px solid var(--border); padding: 12px 16px; color: var(--text); }
  tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
  .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; }
  .badge-green { background: rgba(56,217,169,0.12); color: var(--accent2); }
  .badge-yellow { background: rgba(247,156,79,0.12); color: var(--accent3); }
  .badge-red { background: rgba(247,85,85,0.12); color: var(--danger); }

  /* INTERACTIVE DEMO */
  .demo-panel { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; margin-top: 36px; }
  .demo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .demo-col label { font-size: 13px; color: var(--muted); display: block; margin-bottom: 8px; }
  .demo-slider { width: 100%; accent-color: var(--accent); cursor: pointer; }
  .demo-val { font-size: 20px; font-weight: 700; color: var(--text); margin-top: 4px; font-family: var(--mono); }
  .noise-viz { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin-top: 16px; height: 80px; position: relative; overflow: hidden; }
  .privacy-score { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
  .ps-label { font-size: 13px; color: var(--muted); }
  .ps-value { font-size: 24px; font-weight: 800; font-family: var(--mono); }
  canvas { display: block; width: 100%; height: 100%; }

  /* FOOTER */
  footer { border-top: 1px solid var(--border); padding: 40px; text-align: center; color: var(--muted); font-size: 13px; max-width: 1100px; margin: 0 auto; }
  footer strong { color: var(--text); }

  /* DIVIDER */
  .divider { border: none; border-top: 1px solid var(--border); margin: 0; }

  @media (max-width: 700px) {
    nav { padding: 0 20px; }
    nav .nav-links { display: none; }
    section { padding: 60px 20px; }
    .hero { padding: 60px 20px 40px; }
    .hero-stats { flex-wrap: wrap; gap: 28px; }
    .demo-grid { grid-template-columns: 1fr; }
    .flow-steps { grid-template-columns: 1fr; }
    .flow-step { border-radius: 0 !important; border-left: 1px solid var(--border) !important; }
    .flow-step:first-child { border-radius: var(--radius-lg) var(--radius-lg) 0 0 !important; }
    .flow-step:last-child { border-radius: 0 0 var(--radius-lg) var(--radius-lg) !important; border-top: none !important; }
    .flow-arrow { display: none; }
  }
</style>
</head>
