<span class="kw">import</span> torch
<span class="kw">import</span> torch.nn <span class="kw">as</span> nn
<span class="kw">from</span> opacus <span class="kw">import</span> PrivacyEngine
<span class="kw">from</span> opacus.validators <span class="kw">import</span> ModuleValidator
<span class="kw">from</span> opacus.utils.batch_memory_manager <span class="kw">import</span> BatchMemoryManager
<span class="kw">import</span> numpy <span class="kw">as</span> np
<span class="kw">from</span> typing <span class="kw">import</span> Tuple, Dict, Optional


<span class="kw">class</span> <span class="tp">DPClient</span>:
    <span class="kw">def</span> <span class="fn">__init__</span>(
        self,
        client_id: <span class="tp">int</span>,
        dataset,
        model_fn,
        cfg,
        heterogeneous: <span class="tp">bool</span> = <span class="kw">False</span>,
    ):
        self.id = client_id
        self.dataset = dataset
        self.model_fn = model_fn
        self.cfg = cfg
        self.heterogeneous = heterogeneous
        self._privacy_engine: Optional[PrivacyEngine] = <span class="kw">None</span>
        self._epsilon_spent = <span class="nu">0.0</span>

    <span class="kw">def</span> <span class="fn">_clip_gradients_manual</span>(self, model: nn.Module, clip_norm: <span class="tp">float</span>):
        <span class="cm">"""Manual per-sample gradient clipping (used without Opacus)."""</span>
        total_norm = <span class="nu">0.0</span>
        <span class="kw">for</span> p <span class="kw">in</span> model.parameters():
            <span class="kw">if</span> p.grad <span class="kw">is not None</span>:
                param_norm = p.grad.data.norm(<span class="nu">2</span>)
                total_norm += param_norm.item() ** <span class="nu">2</span>
        total_norm = total_norm ** <span class="nu">0.5</span>
        clip_coef = clip_norm / (<span class="fn">max</span>(total_norm, clip_norm))
        <span class="kw">for</span> p <span class="kw">in</span> model.parameters():
            <span class="kw">if</span> p.grad <span class="kw">is not None</span>:
                p.grad.data.mul_(clip_coef)

    <span class="kw">def</span> <span class="fn">_add_gaussian_noise</span>(self, model: nn.Module, sigma: <span class="tp">float</span>, clip_norm: <span class="tp">float</span>):
        <span class="cm">"""Add calibrated Gaussian noise N(0, (σ·C)²) to all gradients."""</span>
        <span class="kw">for</span> p <span class="kw">in</span> model.parameters():
            <span class="kw">if</span> p.grad <span class="kw">is not None</span>:
                noise = torch.normal(
                    mean=<span class="nu">0</span>,
                    std=sigma * clip_norm,
                    size=p.grad.shape,
                    device=p.grad.device,
                )
                p.grad.data.add_(noise)

    <span class="kw">def</span> <span class="fn">train_with_opacus</span>(self, global_weights: Dict) -> Tuple[Dict, <span class="tp">float</span>]:
        <span class="cm">"""Full DP-SGD via Opacus (recommended for production)."""</span>
        model = self.model_fn().to(self.cfg.device)
        model = ModuleValidator.fix(model)   <span class="cm"># replace BatchNorm → GroupNorm</span>
        model.load_state_dict(global_weights)

        loader = torch.utils.data.DataLoader(
            self.dataset,
            batch_size=self.cfg.local_batch_size,
            shuffle=<span class="kw">True</span>,
            drop_last=<span class="kw">True</span>,   <span class="cm"># Opacus requires fixed batch sizes</span>
        )
        optimizer = torch.optim.SGD(model.parameters(), lr=self.cfg.local_lr, momentum=<span class="nu">0.9</span>)
        criterion = nn.CrossEntropyLoss()

        pe = PrivacyEngine()
        model, optimizer, loader = pe.make_private_with_epsilon(
            module=model,
            optimizer=optimizer,
            data_loader=loader,
            epochs=self.cfg.local_epochs,
            target_epsilon=self.cfg.target_epsilon,
            target_delta=self.cfg.target_delta,
            max_grad_norm=self.cfg.max_grad_norm,
        )
        self._privacy_engine = pe

        model.train()
        <span class="kw">with</span> BatchMemoryManager(
            data_loader=loader,
            max_physical_batch_size=<span class="nu">32</span>,   <span class="cm"># virtual batching for memory</span>
            optimizer=optimizer,
        ) <span class="kw">as</span> mem_loader:
            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(self.cfg.local_epochs):
                <span class="kw">for</span> x, y <span class="kw">in</span> mem_loader:
                    x, y = x.to(self.cfg.device), y.to(self.cfg.device)
                    optimizer.zero_grad()
                    loss = criterion(model(x), y)
                    loss.backward()
                    optimizer.step()

        epsilon = pe.get_epsilon(self.cfg.target_delta)
        self._epsilon_spent = epsilon
        <span class="kw">return</span> model._module.state_dict(), epsilon

    <span class="kw">def</span> <span class="fn">train_manual_dp</span>(self, global_weights: Dict) -> Tuple[Dict, <span class="tp">float</span>]:
        <span class="cm">"""Manual DP-SGD without Opacus (educational / custom scenarios)."""</span>
        model = self.model_fn().to(self.cfg.device)
        model.load_state_dict(global_weights)

        loader = torch.utils.data.DataLoader(self.dataset, batch_size=self.cfg.local_batch_size, shuffle=<span class="kw">True</span>)
        optimizer = torch.optim.SGD(model.parameters(), lr=self.cfg.local_lr)
        criterion = nn.CrossEntropyLoss()

        n = <span class="fn">len</span>(self.dataset)
        q = self.cfg.local_batch_size / n     <span class="cm"># sampling rate</span>
        sigma = self.cfg.noise_multiplier

        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(self.cfg.local_epochs):
            <span class="kw">for</span> x, y <span class="kw">in</span> loader:
                x, y = x.to(self.cfg.device), y.to(self.cfg.device)
                optimizer.zero_grad()
                loss = criterion(model(x), y)
                loss.backward()
                self._clip_gradients_manual(model, self.cfg.max_grad_norm)
                self._add_gaussian_noise(model, sigma, self.cfg.max_grad_norm)
                optimizer.step()

        <span class="cm"># Approximate ε via Gaussian mechanism (simplified — use RDP in prod)</span>
        T = self.cfg.local_epochs * (n // self.cfg.local_batch_size)
        epsilon_approx = q * np.sqrt(T * np.log(<span class="nu">1</span> / self.cfg.target_delta)) / sigma
        <span class="kw">return</span> model.state_dict(), epsilon_approx

    @property
    <span class="kw">def</span> <span class="fn">epsilon_spent</span>(self) -> <span class="tp">float</span>:
        <span class="kw">return</span> self._epsilon_spent</pre>
